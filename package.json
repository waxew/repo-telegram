{
  "name": "repo-telegram",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-tenant Telegram shop-builder bot powered by Cloudflare Workers and Supabase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy --minify",
    "webhook:builder": "node scripts/register-builder-webhook.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
